{
  "$schema": "https://json.schemastore.org/package",
  "name": "highways-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "package": "template package",
    "template": "template repo",
    "test": "pnpm -r run test && pnpm run test:ai-review && pnpm run test:shared",
    "test:shared": "node scripts/check-shared.mjs",
    "test:ai-review": "node --test \"scripts/ai-review/*.test.mjs\"",
    "typecheck": "pnpm -r run typecheck",
    "lint:ste": "ste-lint",
    "ideas": "pnpm --filter @mark1russell7/highways ideas"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@arethetypeswrong/core": "^0.18.5",
    "@mark1russell7/cue": "github:mark1russell7/cue",
    "@mark1russell7/ste-lint": "github:mark1russell7/ste-lint",
    "@mark1russell7/template-cli": "^0.1.0",
    "publint": "^0.3.25",
    "tsdown": "^0.23.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}

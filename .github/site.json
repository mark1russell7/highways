{
  "$comment": "The site config of this repository (CI.md of the template, \"The site config\"). The Pages workflow deploys this site from main, and a job of ci.yml checks it on each pull request.",
  "build": "node packages/site/scripts/bench-overlay.ts && pnpm --filter @highways/site run build",
  "out": "packages/site/dist",
  "env": {
    "SITE_BASE": "/{repo}"
  },
  "site-pages": true,
  "roadmap": "docs/ROADMAP.md",
  "data-stamps": "packages/site/dist/data-stamps.json",
  "packages": "@mark1russell7/highways",
  "site-name": "highways",
  "site-check": true,
  "site-check-pages": "/,/compare.html,/examples.html,/results.html,/strategies.html,/atlas.html,/explorer.html,/releases/,/status/",
  "site-check-probe": "packages/site/src/check-probe.ts"
}

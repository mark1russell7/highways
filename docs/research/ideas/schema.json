{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mark1russell7/highways/docs/research/ideas/schema.json",
  "title": "Idea record",
  "description": "One idea of the catalog (IDEA0). Each family file holds an array of these records. docs/research/CATALOG.md tells the fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "family",
    "name",
    "kind",
    "sources",
    "step",
    "mechanism",
    "math",
    "cost",
    "params",
    "wins",
    "risks",
    "placementDependent",
    "screen",
    "prototype",
    "stage",
    "related",
    "wave"
  ],
  "properties": {
    "id": { "$ref": "#/$defs/ideaId" },
    "family": { "enum": ["highway", "wild", "fields", "nature", "rules"] },
    "name": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["literature", "ours", "hybrid"] },
    "method": { "type": "string", "minLength": 1, "description": "The method of a WILD idea." },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "authors", "year", "url"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "authors": { "type": "string" },
          "year": { "type": "integer", "minimum": 1700, "maximum": 2100 },
          "url": { "type": "string", "pattern": "^https?://" }
        }
      }
    },
    "step": { "enum": ["plugs", "group", "levels", "room", "router", "highway", "curve", "whole"] },
    "mechanism": { "type": "string", "minLength": 1 },
    "math": { "type": "string", "minLength": 1 },
    "cost": { "type": "string", "minLength": 1 },
    "params": { "type": "array", "items": { "type": "string" } },
    "wins": { "$ref": "#/$defs/measureIds" },
    "risks": { "$ref": "#/$defs/measureIds" },
    "placementDependent": { "type": "boolean" },
    "screen": { "type": "string", "minLength": 1 },
    "prototype": { "enum": ["S", "M", "L"] },
    "stage": { "$ref": "#/$defs/stage" },
    "related": { "$ref": "#/$defs/ideaIds" },
    "same": {
      "$ref": "#/$defs/ideaIds",
      "description": "The other records of the same duplicate group."
    },
    "canonical": {
      "$ref": "#/$defs/ideaId",
      "description": "The record of the group that gets built. Only the other members of a group have this field."
    },
    "dependsOn": {
      "$ref": "#/$defs/ideaIds",
      "description": "The ideas that must be built first."
    },
    "wave": { "type": "integer", "minimum": 1, "maximum": 9, "description": "The wave of BUILD-W." },
    "rules": { "type": "string", "minLength": 1, "description": "The soft rules of a RULE idea." },
    "hardRules": { "type": "string", "minLength": 1, "description": "How a RULE idea keeps the hard rules." },
    "zoom": { "type": "string", "minLength": 1, "description": "How a RULE idea behaves between the zoom levels." },
    "result": { "$ref": "#/$defs/result" }
  },
  "allOf": [
    {
      "if": { "properties": { "stage": { "const": "dropped" } }, "required": ["stage"] },
      "then": { "required": ["result"] }
    },
    {
      "if": { "properties": { "family": { "const": "highway" } }, "required": ["family"] },
      "then": { "properties": { "id": { "pattern": "^HWY-" } } }
    },
    {
      "if": { "properties": { "family": { "const": "wild" } }, "required": ["family"] },
      "then": { "required": ["method"], "properties": { "id": { "pattern": "^WILD-" } } }
    },
    {
      "if": { "properties": { "family": { "const": "fields" } }, "required": ["family"] },
      "then": { "properties": { "id": { "pattern": "^EDA-" } } }
    },
    {
      "if": { "properties": { "family": { "const": "nature" } }, "required": ["family"] },
      "then": { "properties": { "id": { "pattern": "^NAT-" } } }
    },
    {
      "if": { "properties": { "family": { "const": "rules" } }, "required": ["family"] },
      "then": { "required": ["rules", "hardRules", "zoom"], "properties": { "id": { "pattern": "^RULE-" } } }
    }
  ],
  "$defs": {
    "ideaId": { "type": "string", "pattern": "^(HWY|WILD|EDA|NAT|RULE)-[0-9]{3}$" },
    "ideaIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/ideaId" } },
    "measureId": { "type": "string", "pattern": "^[A-Z][0-9]{1,2}$" },
    "measureIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/measureId" } },
    "stage": { "enum": ["cataloged", "screened", "prototyped", "built", "kept", "dropped"] },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["records", "measures", "date"],
      "description": "The screen result. A dropped record must have one.",
      "properties": {
        "records": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "The ids of the screen records (layout-record/1)."
        },
        "measures": { "$ref": "#/$defs/measureIds", "description": "The measures that decided." },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "summary": { "type": "string", "minLength": 1 }
      }
    }
  }
}

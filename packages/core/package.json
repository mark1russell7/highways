{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/highways",
  "description": "Edge routers for node-link diagrams: shared trunks, bundles and zoom levels, with a benchmark of their quality.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/highways.git",
    "directory": "packages/core"
  },
  "homepage": "https://mark1russell7.github.io/highways/",
  "version": "0.15.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./strategy-ideas": "./scripts/strategy-ideas.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "src",
    "!src/**/*.test.ts"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "bench": "node scripts/bench.ts",
    "ideas": "node scripts/ideas.ts",
    "queue": "node scripts/queue.ts",
    "bench:join": "node scripts/bench-join.ts",
    "profile": "node scripts/profile.ts",
    "levels": "node scripts/levels.ts",
    "screen": "node scripts/screen.ts",
    "promotion": "node scripts/promotion.ts",
    "exact": "node scripts/exact.ts",
    "oracle": "node scripts/oracle.ts",
    "portfolio": "node scripts/portfolio.ts",
    "portfolio:time": "node scripts/portfolio-time.ts",
    "portfolio:sets": "node scripts/portfolio-sets.ts",
    "portfolio:api": "node scripts/portfolio-api-report.ts",
    "bounds": "node scripts/bounds.ts",
    "screen:inputs": "node scripts/screen-inputs.ts",
    "predicate:dump": "node scripts/predicate-dump.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "gate:pool": "node scripts/sections-gate-pool.ts"
  },
  "dependencies": {
    "@mark1russell7/layout-contract": "^0.5.1",
    "@mark1russell7/predicates": "^0.1.0",
    "@mark1russell7/rigor-generators": "^0.1.1",
    "@mark1russell7/rigor-statistics": "^0.1.5"
  },
  "devDependencies": {
    "@mark1russell7/cue": "github:mark1russell7/cue#9005ddbd0aac6d10992f638506b14e16b1eb2de8",
    "@mark1russell7/rigor-bench": "^0.2.14",
    "@types/node": "^26.6.4",
    "highs": "^1.15.4",
    "highways-0-5-1": "npm:@mark1russell7/highways@0.5.1",
    "highways-0-8-0": "npm:@mark1russell7/highways@0.8.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}

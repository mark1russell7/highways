{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/highways",
  "description": "Edge routers for node-link diagrams: shared trunks, bundles and zoom levels, with a benchmark of their quality.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/highways.git",
    "directory": "packages/core"
  },
  "homepage": "https://mark1russell7.github.io/highways/",
  "version": "0.5.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "src",
    "!src/**/*.test.ts"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "bench": "node scripts/bench.ts",
    "ideas": "node scripts/ideas.ts",
    "bench:join": "node scripts/bench-join.ts",
    "profile": "node scripts/profile.ts",
    "levels": "node scripts/levels.ts",
    "screen": "node scripts/screen.ts",
    "screen:inputs": "node scripts/screen-inputs.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@mark1russell7/cue": "github:mark1russell7/cue",
    "@mark1russell7/layout-contract": "^0.2.1",
    "@types/node": "^26.6.4",
    "highs": "^1.15.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
